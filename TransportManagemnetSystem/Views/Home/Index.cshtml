@using TransportManagemnetSystem.Security
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    string[] css = { "total-project border-b-primary", "total-Progress border-b-warning", "total-Complete border-b-secondary" };
    string[] csslight = { "bg-primary-light", "bg-warning-light", "bg-secondary-light" };
    string[] hrefs = { "/assets/svg/icon-sprite.svg#color-swatch", "/assets/svg/icon-sprite.svg#tick-circle", "/assets/svg/icon-sprite.svg#add-square" };

    string[] orgcss = { "bg-yellow", "bg-red", "bg-green", "bg-blue" };
}
<style>
    .highcharts-figure,
    .highcharts-data-table table {
        min-width: 320px;
        max-width: 660px;
        margin: 1em auto;
    }

    .highcharts-data-table table {
        font-family: Verdana, sans-serif;
        border-collapse: collapse;
        border: 1px solid #ebebeb;
        margin: 10px auto;
        text-align: center;
        width: 100%;
        max-width: 500px;
    }

    .highcharts-data-table caption {
        padding: 1em 0;
        font-size: 1.2em;
        color: #555;
    }

    .highcharts-data-table th {
        font-weight: 600;
        padding: 0.5em;
    }

    .highcharts-data-table td,
    .highcharts-data-table th,
    .highcharts-data-table caption {
        padding: 0.5em;
    }

    .highcharts-data-table thead tr,
    .highcharts-data-table tr:nth-child(even) {
        background: #f8f8f8;
    }

    .highcharts-data-table tr:hover {
        background: #f1f7ff;
    }

    .highcharts-credits {
        display: none !important;
    }



    /* for subadmin */
    body {
        font-family: 'Roboto', sans-serif;
        background-color: #f5f7fa;
        margin: 0;
        padding: 0;
    }

    .sidebar {
        height: 100vh;
        background-color: #fff;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        position: fixed;
        width: 250px;
        padding-top: 20px;
    }

        .sidebar a {
            color: #6c757d;
            padding: 10px 20px;
            display: block;
            text-decoration: none;
            transition: color 0.3s;
        }

            .sidebar a:hover {
                color: #007bff;
            }

            .sidebar a.active {
                background-color: #e9ecef;
                color: #007bff;
            }

    .main-content {
        margin-left: 250px;
        padding: 20px;
    }

    /* Base styling for metric-card */
    .metric-card {
        padding: 20px;
        border-radius: 8px;
        color: white;
        text-align: center;
        opacity: 0;
        /* Start invisible */
    }



    /* Slide from left animation */
    .slide-from-left {
        transform: translateX(-50px);
        /* Start off-screen to the left */
        animation: slideInLeft 0.5s ease-out forwards;
    }

    /* Slide from right animation */
    .slide-from-right {
        transform: translateX(50px);
        /* Start off-screen to the right */
        animation: slideInRight 0.5s ease-out forwards;
    }


    /* Keyframes for sliding from left */
    @@keyframes slideInLeft {
        0% {
            opacity: 0;
            transform: translateX(-50px);
        }

        100% {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Keyframes for sliding from right */
    @@keyframes slideInRight {
        0% {
            opacity: 0;
            transform: translateX(50px);
        }

        100% {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Animation for both card and metric-card */
    .card,
    .metric-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
        border-radius: 10px;
    }

        .card:hover,
        .metric-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

    .metric-card {
        background-color: #fff;
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        color: #fff;
    }

        .metric-card h3 {
            font-size: 1.5rem;
            margin-bottom: 10px;
        }

        .metric-card p {
            font-size: 0.9rem;
            opacity: 0.8;
        }

    .bg-yellow {
        /* background-color: #ffc107; */
        background: oklch(68.1% 0.162 75.834);
    }

    .bg-red {
        /* background-color: #dc3545; */
        background-color: oklch(63.7% 0.237 25.331);
    }

    .bg-green {
        /* background-color: #28a745; */
        background: oklch(44.8% 0.119 151.328);
    }

    .bg-blue {
        /* background-color: #007bff; */
        background: oklch(62.3% 0.214 259.815);
    }

    .chart-container {
        background-color: #fff;
        border-radius: 10px;
        padding: 20px;
        height: 300px;
    }

    @@media (max-width: 768px) {
        .sidebar {
            width: 100%;
            height: auto;
            position: relative;
        }

        .main-content {
            margin-left: 0;
        }
    }



    .col-md-3 {
        flex: 0 0 25%;
        max-width: 25%;
        padding: 0 15px;
        position: relative;
        z-index: 1;
    }

    .mb-3 {
        margin-bottom: 1rem !important;
    }

    /* Metric card with bubble background container */
    .metric-card {
        position: relative;
        overflow: hidden;
        /* background-color: #ffc9289f; */
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        text-align: center;
        transition: transform 0.3s ease;
    }

        .metric-card:hover {
            transform: translateY(-5px);
        }

    /* 3D-style bubbles container */
    .bubbles {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 0;
    }

    .bubble {
        position: absolute;
        bottom: -100px;
        width: 20px;
        height: 20px;
        background: rgba(255, 255, 255, 0.4);
        border-radius: 50%;
        animation: rise 10s infinite ease-in;
    }

        /* Vary size and animation delay for realism */
        .bubble:nth-child(2) {
            left: 20%;
            width: 15px;
            height: 15px;
            animation-delay: 2s;
            animation-duration: 12s;
        }

        .bubble:nth-child(3) {
            left: 40%;
            width: 25px;
            height: 25px;
            animation-delay: 4s;
            animation-duration: 9s;
        }

        .bubble:nth-child(4) {
            left: 60%;
            width: 10px;
            height: 10px;
            animation-delay: 1s;
            animation-duration: 10s;
        }

        .bubble:nth-child(5) {
            left: 80%;
            width: 18px;
            height: 18px;
            animation-delay: 3s;
            animation-duration: 11s;
        }

    @@keyframes rise {
        0% {
            transform: translateY(0) scale(1);
            opacity: 0.5;
        }

        50% {
            opacity: 1;
        }

        100% {
            transform: translateY(-300px) scale(1.2);
            opacity: 0;
        }
    }

    /* Text layer above bubbles */
    .metric-card h3,
    .metric-card p {
        position: relative;
        z-index: 1;
    }

    .fw-semibold {
        font-weight: 600 !important;
    }

    .fw-bold {
        font-weight: 700 !important;
    }

    .fs-3 {
        font-size: 1.5rem !important;
    }

    .fs-2 {
        font-size: 1.25rem !important;
    }

    .lh-sm {
        line-height: 1.2 !important;
    }

    /* Slide animation */
    @@keyframes slideFromLeft {
        from {
            opacity: 0;
            transform: translateX(-50px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .slide-from-left {
        animation: slideFromLeft 0.5s ease-out forwards;
    }

    @@media (max-width: 767.98px) {
        .col-md-3 {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .metric-card {
            padding: 15px;
        }

        .fs-3 {
            font-size: 1.25rem !important;
        }

        .fs-2 {
            font-size: 1rem !important;
        }
    }

    /* ===================================================== 3D bar chart ================================== */


    #container3D {
        height: 400px;
        width: 100%;
        margin: 0 auto;
    }

    @@media (max-width: 576px) {
        #container {
            height: 300px;
        }
    }

    .route-block {
        margin-bottom: 20px;
        font-size: 16px;
    }

    .stop {
        display: inline-block;
        padding: 5px 10px;
        background: #f0f0f0;
        border-radius: 10px;
        margin: 0 5px;
    }


</style>
