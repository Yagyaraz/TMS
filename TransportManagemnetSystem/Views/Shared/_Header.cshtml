@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using TransportManagemnetSystem.Data
@using TransportManagemnetSystem.Security
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!-- Page Header Start-->
<div class="page-header">
    <div class="header-wrapper row m-0">

        <div class="header-logo-wrapper col-auto p-0">
            <div class="logo-wrapper"> <a href="index.html"><img class="img-fluid for-light" src="~/assets/images/logo/logo_dark.png" alt="logo-light"><img class="img-fluid for-dark" src="~/assets/images/logo/logo.png" alt="logo-dark"></a></div>
            <div class="toggle-sidebar"> <i class="status_toggle middle sidebar-toggle" data-feather="align-center"></i></div>
        </div>
        <div class="left-header col-xxl-5 col-xl-6 col-lg-5 col-md-4 col-sm-3 p-0">
            <span>@User.FindFirstValue("OrgName") </span>
        </div>
        <div class="nav-right col-xxl-7 col-xl-6 col-md-7 col-8 pull-right right-header p-0 ms-auto">
            <ul class="nav-menus">
                <li>Hello @User.FindFirstValue("Email") !</li>
                <li>
                    <div class="mode"><i class="moon" data-feather="moon"> </i></div>
                </li>

                <li class="profile-nav onhover-dropdown">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="media profile-media">
                            <img class="b-r-10" src="~/assets/images/dashboard/profile.png" alt="">
                            @*  <div class="media-body d-xxl-block d-none box-col-none">
                                <div class="d-flex align-items-center gap-2"> <span>Hello @User.FindFirstValue("Email") !</span><i class="middle fa fa-angle-down"> </i></div>
                                <p class="mb-0 font-roboto">Admin</p>
                            </div> *@
                        </div>

                        <ul class="profile-dropdown onhover-show-div">
                            @*  <li><a href="user-profile.html"><i data-feather="user"></i><span>My Profile</span></a></li>
                        <li><a href="letter-box.html"><i data-feather="mail"></i><span>Inbox</span></a></li> *@
                            @if (!User.IsInRole(UserRoles.User) && !User.IsInRole(UserRoles.SubAdmin) && !User.IsInRole(UserRoles.OrgUser))
                            {
                                <li> <a asp-area="Admin" asp-controller="UserControl" asp-action="UserList"> <i data-feather="user"></i><span>प्रयोगकर्ता सुची</span></a></li>
                                <li> <a asp-area="Admin" asp-controller="UserControl" asp-action="UserLogDetails"> <i data-feather="settings"></i><span>User Log</span></a></li>
                            }
                            @if (User.IsInRole(UserRoles.SubAdmin))
                            {
                                <li> <a asp-area="Admin" asp-controller="UserControl" asp-action="OrgUserList"> <i data-feather="user"></i><span>प्रयोगकर्ता सुची</span></a></li>
                            }
                            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Login", "Account", new { area = "Identity" })">
                            <li><button class="btn btn-pill btn-outline-primary btn-sm" id="logout" type="submit">Log Out</button></li>
                            </form>

                        </ul>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- Page Header Ends -->