<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_AllCssFile" />
</head>
<body>

    <!-- loader starts-->
    <div class="loader-wrapper">
        <div class="loader">
            <div class="loader4"></div>
        </div>
    </div>
    <!-- loader ends-->
    <!-- tap on top starts-->
    <div class="tap-top"><i data-feather="chevrons-up"></i></div>
    <!-- tap on tap ends-->
    <!-- page-wrapper Start-->
    <div class="page-wrapper compact-wrapper" id="pageWrapper">
        <partial name="_Header" />

        <!-- Page Body Start-->
        <div class="page-body-wrapper">
            <partial name="_LeftMenu" />

            <div class="page-body">
                @RenderBody()
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12 footer-copyright text-center">
                            <p class="mb-0">&copy; 2024 - Softech Foundation PVT. LTD. - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> </p>
                        </div>
                    </div>
                </div>
            </footer>

            <partial name="_AllScriptsFile" />


            @await RenderSectionAsync("Scripts", required: false)
        </div>
    </div>
</body>
</html>
