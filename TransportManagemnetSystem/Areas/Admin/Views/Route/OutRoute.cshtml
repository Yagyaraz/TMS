@model IEnumerable<OutRouteViewModel>
@{
    ViewData["Title"] = "Vehicle OutRoute List";
}
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pb-0 card-no-border">
                <div>
                    <h4>@ViewData["Title"]</h4>
                </div>

                <div>
                    @*   @if (User.IsInRole(UserRoles.SubAdmin))
                    { *@
                    <p class="mb-0"><a class="btn btn-primary pull-right btn-add" asp-action="CreateOutRoute"><i class="fa fa-plus"></i> &nbsp; नयाँ बनाउनुहोस्</a></p>
                    @* } *@
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive custom-scrollbar">
                    <table class="display" id="basic-1">
                        <thead>
                            <tr>
                                <th>क्र. स.</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.RouteName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.SourceName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.SourceTime)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.DestinationName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.DestinationTime)
                                </th>
                                <th></th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@string.Format("{0}", Model.ToList().IndexOf(item) + 1)</td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.RouteName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.SourceName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.SourceTime)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DestinationName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DestinationTime)
                                    </td>
                                    <td>
                                        @*     @if (User.IsInRole(UserRoles.SubAdmin))
                                        { *@
                                        <a asp-action="CreateOutRoute" asp-route-id="@item.Id"><i class="fa fa-edit"></i></a>
                                        @* } *@
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
