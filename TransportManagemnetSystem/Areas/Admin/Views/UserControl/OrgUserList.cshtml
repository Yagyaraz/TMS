@using TransportManagemnetSystem.Security
@model IEnumerable<OrgUserViewModel>
@inject IUtility _utility

@{
    ViewData["Title"] = "प्रयोगकर्ता सुची";
}
<style>
    .green-box {
        width: 15px;
        height: 15px;
        background-color: #008028;
    }

    .gray-box {
        width: 15px;
        height: 15px;
        background-color: #80a0ca;
    }
</style>
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pb-0 card-no-border">
                <div>
                    <h4>@ViewData["Title"]</h4>

                </div>
                <div>
                    <p class="mb-0"><a class="btn btn-primary pull-right btn-add" asp-area="Identity" asp-page="/Account/OrgUserRegister"><i class="fa fa-plus"></i> &nbsp; नयाँ बनाउनुहोस्</a></p>

                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive custom-scrollbar">
                    <table class="display" id="basic-1">
                        <thead>
                            <tr>
                                <th>S.N</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>
                                 <th>
                                    @Html.DisplayNameFor(model => model.Email)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.MobileNo)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Address)
                                </th>
                                    <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @($"{Model.ToList().IndexOf(item) + 1}")
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                      <td>
                                        @Html.DisplayFor(modelItem => item.Email)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MobileNo)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Address)
                                    </td>
                                    <td>
                                    </td>
                                   
                                    }
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
               
            </div>
        </div>
    </div>
</div>
