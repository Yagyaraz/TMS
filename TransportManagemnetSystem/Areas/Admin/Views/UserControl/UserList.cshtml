@using TransportManagemnetSystem.Security
@model IEnumerable<UserViewModel>
@inject IUtility _utility

@{
    ViewData["Title"] = "प्रयोगकर्ता सुची";
}
<style>
    .green-box {
        width: 15px;
        height: 15px;
        background-color: #008028;
    }

    .gray-box {
        width: 15px;
        height: 15px;
        background-color: #80a0ca;
    }
</style>
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pb-0 card-no-border">
                <div>
                <h4>@ViewData["Title"]</h4>

                </div>
                <div>
                    <p class="mb-0"><a class="btn btn-primary pull-right btn-add" asp-area="Identity" asp-page="/Account/Register"><i class="fa fa-plus"></i> &nbsp; नयाँ बनाउनुहोस्</a></p>

                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive custom-scrollbar">
                    <table class="display" id="basic-1">
                        <thead>
                            <tr>
                                <th>S.N</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>
                               @*  <th>
                                    @Html.DisplayNameFor(model => model.UserName)
                                </th> *@
                                <th>
                                    @Html.DisplayNameFor(model => model.Role)
                                </th>
                              @*   <th>
                                    @Html.DisplayNameFor(model => model.WardName)
                                </th> *@
                                <th>
                                    @Html.DisplayNameFor(model => model.Active)
                                </th>
                                @if (User.IsInRole(UserRoles.Administrator) || User.IsInRole(UserRoles.SuperAdmin))
                                {
                                    <th></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var color = item.Active ? "green" : "red";
                                var isActive = item.Active ? "Active" : "InActive";
                                var isChecked = item.Active ? "checked" : "";
                                <tr style="color: @color">
                                    <td>
                                        @($"{Model.ToList().IndexOf(item) + 1}")
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                  @*   <td>
                                        @Html.DisplayFor(modelItem => item.UserName)
                                    </td> *@
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Role)
                                    </td>
                                    @* <td>
                                        @Html.DisplayFor(modelItem => item.WardName)
                                    </td> *@
                                    <td>
                                        @isActive
                                    </td>
                                    @if (User.IsInRole(UserRoles.Administrator) || User.IsInRole(UserRoles.SuperAdmin))
                                    {
                                        <td>
                                            @* <a asp-action="UpdateUser" asp-route-id="@item.Id">Edit</a>
                                            <a href="#" title="Reset Password" onclick="ResetPassword(this, '@item.Id', '@item.Name')"><i class="fa fa-unlock-alt"></i></a> |
                                            <input type="checkbox" @isChecked onchange="IsApprovedOrNot(this, '@item.Id')" style="" data-toggle="toggle" data-on="Activate" data-off="DeActivate" data-onstyle="success" data-offstyle="danger" data-size="xs" />
                                           *@
                                            @if (item.Role == null && User.IsInRole(UserRoles.SuperAdmin))
                                            {
                                                <select asp-for="@item.Role" asp-items="await _utility.GetSelectListRoles()" onchange="ChangeRole(this, '@item.Id', '@item.Name')">
                                                    <option>Select Role</option>
                                                </select>
                                            }
                                            @if (User.IsInRole(UserRoles.Administrator))
                                            {
                                                <select asp-for="@item.Role" asp-items="await _utility.GetSelectListRoles()" onchange="ChangeRole(this, '@item.Id', '@item.Name')">
                                                    <option>Select Role</option>
                                                </select>
                                            }
                                        </td>
                                    }
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="green-box"></div>
                    <span> - approved</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="gray-box"></div>
                    <span> - unapproved/pending</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script>
        function ChangeRole(a, id, name) {
            
            var role = $(a).val();           
            $.confirm({
                title: 'Change Role?',
                content: `Are you sure User Name ${name}`,
                autoClose: 'cancelAction|8000',
                buttons: {
                    resetPassword: {
                        text: 'Change Role',
                        btnClass: 'btn-green',
                        action: function () {
                            $.ajax({
                                url: '@Url.Action("ChangeRole")',
                                type: 'get',
                                data: { id: id, role: role },
                                success: function (result) {
                                    if (result === true) {
                                        $(a).closest('tr').find('.Roles').html(role);
                                        window.location.reload(true);

                                    } else {
                                        $.alert('Please try again!');
                                    }
                                },
                                error: function () {
                                    $.alert('error in calling ajax !!');
                                }
                            });
                        }
                    },
                    cancelAction: function () {
                    }
                }
            });
        }
    </script>

}
