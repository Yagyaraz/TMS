@model IEnumerable<UserLogViewModel>
@{
    ViewData["Title"] = "प्रयोगकर्ता लग विवरणहरू";
}
<form asp-action="UserLogDetails" method="get" class="row pb-2">
    <div class="form-group col-md-4">
        <label for="email">Email</label>
        @* <input type="text" class="form-control" name="email" value="@ViewBag.email" placeholder="Enter Email" required /> *@
        <select name="userid" id="userid" asp-items="@await _Utility.GetUserList()" class="form-control">
            <option value="">--Select--</option>
        </select>
    </div>
    <div class="col-md-4 pt-4">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pb-0 card-no-border">
                <div>
                    <h4>@ViewData["Title"]</h4>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive custom-scrollbar">
                    <table class="display" id="basic-1">
                        <thead>
                            <tr>
                                <th>S.N</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Username)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Action)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Timestamp)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @($"{Model.ToList().IndexOf(item) + 1}")
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Username)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Action)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Timestamp)
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>


@section Scripts
{

   
    <script>
        $(document).ready(function () {
            $('#userid').val('@ViewBag.userid').trigger('change');
        })
    </script>
}
