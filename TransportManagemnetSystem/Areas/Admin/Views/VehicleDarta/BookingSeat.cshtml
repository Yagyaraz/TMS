@model List<TransportManagemnetSystem.Areas.Admin.Models.Seat>

@{
    ViewData["Title"] = "Bus Seat Booking";
    int vehicleId = ViewBag.VehicleId;
}


<style>
    .seat {
        width: 60px;
        height: 60px;
        margin: 5px;
        background-color: #28a745; /* Green */
        color: white;
        text-align: center;
        line-height: 60px;
        border-radius: 8px;
        font-weight: bold;
        font-size: 18px;
        cursor: pointer;
        background-image: url('/assets/images/car-seat.png');
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover; /* Ensures the image scales well */
    }

    .booked {
        background-color: #dc3545; /* Red */
        pointer-events: none; /* Disable booked seats */
    }

    .selected {
        background-color: #ffc107; /* Yellow for selected seats */
    }

    .driver-seat {
        width: 60px;
        height: 60px;
        background-color: #6c757d; /* Grey */
        color: white;
        text-align: center;
        border-radius: 50%;
        margin: 10px auto;
        position: relative;
    }

    .driver-icon {
        font-size: 20px;
        position: absolute;
        top: 5px;
        left: 50%;
        transform: translateX(-50%);
    }

    .steering-wheel {
        font-size: 25px;
        position: absolute;
        bottom: 5px;
        left: 50%;
        transform: translateX(-50%);
    }

    .bus-container {
        position: relative;
        max-width: 500px;
        margin: auto;
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    }

    .aisle {
        width: 20px;
    }

    .bus-container {
        position: relative;
        background-color: #f2f2f2;
        border-radius: 10px;
        padding: 20px;
        width: 80%;
        margin: auto;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    .wheel {
        width: 50px;
        height: 50px;
        background-image: url('/assets/images/tyre.png');
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover; /* Ensures the image scales well */
        border-radius: 50%;
        position: absolute;
        top: 30%; /* Vertically center the wheels */
        transform: translateY(-50%);
    }

    .wheel2 {
        width: 50px;
        height: 50px;
        background-image: url('/assets/images/tyre.png');
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover; /* Ensures the image scales well */
        border-radius: 50%;
        position: absolute;
        top: 80%; /* Vertically center the wheels */
        transform: translateY(-50%);
    }
    .wheel-left {
        left: -30px; /* Position the left wheel to the left side */
    }

    .wheel-right {
        right: -30px; /* Position the right wheel to the right side */
    }
</style>
<div class="container pb-2 mb-2">
    <div class="row">
        <div class="col-md-4 offset-2"> <h2>Bus Seat Booking</h2></div>
    </div>

</div>
<div class="bus-container position-relative">
    <!-- Wheels -->
    <div class="wheel wheel-left"></div>
    <div class="wheel wheel-right"></div>
    <div class="wheel2 wheel-left"></div>
    <div class="wheel2 wheel-right"></div>
    <!-- Driver Seat -->

    <div class="row pb-4" style="border-bottom:1px solid black">
        <div class="col-md-12">
            <div style="height:5px;    background-color: rgb(121, 119, 119)"></div>
        </div>
        <div class="col-3 offset-9 text-center pt-4">
            <div class=" driver-seat">
                <img src="~/assets/images/driver.png" />
            </div>
        </div>
    </div>

    <!-- Main Seats with Aisle -->
    <div class="row pt-6">
        <input type="hidden" id="vehicleId" value="@vehicleId" />
        <div class="col-md-6">
        </div>
        @for (int i = 0; i < Model.Count; i += 4)
        {
            <div class="col-6 d-flex justify-content-end mb-3 gap-4">
                <div>
                    <div class="seat @(Model[i].IsBooked ? "booked" : "")" data-seat="@Model[i].SeatNumber">
                    </div>
                    <div class="text-center fs-4">
                        @Model[i].SeatNumber
                    </div>
                </div>
                @if (i + 1 < Model.Count)
                {
                    <div>
                        <div class="seat @(Model[i + 1].IsBooked ? "booked" : "")" data-seat="@Model[i + 1].SeatNumber">
                        </div>
                        <div class="text-center fs-4">
                            @Model[i + 1].SeatNumber
                        </div>
                    </div>
                }
            </div>



            <div class="col-6 d-flex justify-content-start mb-3 gap-4">
                @if (i + 2 < Model.Count)
                {
                    <div>

                        <div class="seat @(Model[i + 2].IsBooked ? "booked" : "")" data-seat="@Model[i + 2].SeatNumber">
                        </div>
                        <div class="text-center fs-4">
                            @Model[i + 2].SeatNumber
                        </div>
                    </div>
                }
                @if (i + 3 < Model.Count)
                {
                    <div>
                        <div class="seat @(Model[i + 3].IsBooked ? "booked" : "")" data-seat="@Model[i + 3].SeatNumber">
                        </div>
                        <div class="text-center fs-4">
                            @Model[i + 3].SeatNumber
                        </div>
                    </div>

                }
            </div>
        }
    </div>

    <!-- Book Button -->
    <div class="text-center mt-4">
        <button id="bookSeatsBtn" class="btn btn-primary">Book Selected Seats</button>
    </div>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // Store selected seats
    let selectedSeats = [];

    // Handle seat click
    $(".seat").not(".booked").click(function () {
        const seatNumber = $(this).data("seat");

        // Toggle seat selection
        if ($(this).hasClass("selected")) {
            $(this).removeClass("selected");
            selectedSeats = selectedSeats.filter(s => s !== seatNumber);
        } else {
            $(this).addClass("selected");
            selectedSeats.push(seatNumber);
        }

        console.log(selectedSeats); // For debugging
    });

    // Handle book button click
    $("#bookSeatsBtn").click(function () {
        if (selectedSeats.length === 0) {
            alert("Please select at least one seat.");
            return;
        }

        const Vehicleid = $("#vehicleId").val();
        const requestData = {
        Vehicleid: Vehicleid,
        SeatNumbers: selectedSeats
    };
        // AJAX call to book seats
        $.ajax({
            url: '@Url.Action("BookSeats", "VehicleDarta", new { area = "Admin" })',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(requestData),
            success: function (response) {
                alert("Seats booked successfully!");
                 selectedSeats.forEach(seat => {s
                     $(`.seat[data-seat="${seat}"]`).addClass("booked").removeClass("selected").off("click");
                 });
                 selectedSeats = [];
               // location.reload(); // Reload to update seat status
            },
            error: function () {
                alert("Failed to book seats. Please try again.");
            }
        });
    });
</script>
