@section Scripts {
    <script>
        function PrintReport(divele) {
            var printContent = document.getElementById(divele).innerHTML;
            var originalContent = document.body.innerHTML;
            document.body.innerHTML = printContent;
            window.print();
            document.body.innerHTML = originalContent;
        }

    </script>
}