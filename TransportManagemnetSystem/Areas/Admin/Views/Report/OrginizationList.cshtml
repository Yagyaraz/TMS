@model IEnumerable<OrginizationReportViewModel>
@{
    ViewData["Title"] = "समिति सूची";
    // ViewData["Title"] = "Committee List";
}
<style>
    .green-box {
        width: 15px;
        height: 15px;
        background-color: #008028;
    }

    .gray-box {
        width: 15px;
        height: 15px;
        background-color: #80a0ca;
    }

    .fa .fa-info-circle{
       font-size:1.2rem!important;
    }

        .fa {
            font-size: 1.2rem !important;
        }
</style>
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pb-0 card-no-border">
                <div>
                    <h4>@ViewData["Title"]</h4>
                </div>

                <div>
                  @*   @if (User.IsInRole(UserRoles.SubAdmin))
                    {
                        <p class="mb-0"><a class="btn btn-primary pull-right btn-add" asp-action="CreateVehicleDarta"><i class="fa fa-plus"></i> &nbsp; नयाँ बनाउनुहोस्</a></p>
                    } *@
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive custom-scrollbar">
                    <table class="display" id="basic-1">
                        <thead>
                            <tr>
                                <th>क्र. स.</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.OrganizationName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.DartaMiti)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.DartaLocation)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.PhoneNumber)
                                </th>
                               @*  <th>
                                    @Html.DisplayNameFor(model => model.TotalSeat)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.VehicleModel)
                                </th> *@
                                <th></th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@string.Format("{0}", Model.ToList().IndexOf(item) + 1)</td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.OrganizationName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DartaMiti)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DartaLocation)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PhoneNumber)
                                    </td>
                                   @*  <td>
                                        @Html.DisplayFor(modelItem => item.TotalSeat)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.VehicleModel)
                                    </td> *@
                                    <td>

                                        <a asp-action="OrginizationDetailById" asp-route-id="@item.Id"><i class="fa fa-info-circle"></i></a>
                                        

                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
               @*  <div class="d-flex align-items-center gap-2">
                    <div class="green-box"></div>
                    <span> - approved</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="gray-box"></div>
                    <span> - unapproved/pending</span>
                </div> *@
            </div>
        </div>
    </div>
</div>
