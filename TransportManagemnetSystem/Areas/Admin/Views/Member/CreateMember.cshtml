@model MemberViewModel
@{
    ViewData["Title"] = "सदस्य दर्ता";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <h4>@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <form class="row g-3 needs-validation custom-input" asp-action="CreateMember" enctype="multipart/form-data">
                    <span asp-validation-summary="ModelOnly" class="text-danger"></span>
                    <input asp-for="Id" type="hidden" />
                    <div class="col-md-4 position-relative">
                        <label asp-for="FullName" class="control-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="FullNameEng" class="control-label"></label>
                        <input asp-for="FullNameEng" class="form-control" />
                        <span asp-validation-for="FullNameEng" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="CitizenNo" class="control-label"></label>
                        <input asp-for="CitizenNo" class="form-control" />
                        <span asp-validation-for="CitizenNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="CitizenIssueDate" class="control-label"></label>
                        <input asp-for="CitizenIssueDate" class="form-control" />
                        <span asp-validation-for="CitizenIssueDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="CitizenIssueDistricrId" class="control-label"></label>
                        <select asp-for="CitizenIssueDistricrId" asp-items="@await _Utility.GetDistrictSelectListItems(null)" class="form-select">
                            <option value="">-- District--</option>
                        </select>
                        <span asp-validation-for="CitizenIssueDistricrId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="RegNo" class="control-label"></label>
                        <input asp-for="RegNo" class="form-control" />
                        <span asp-validation-for="RegNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="PanVatNo" class="control-label"></label>
                        <input asp-for="PanVatNo" class="form-control" />
                        <span asp-validation-for="PanVatNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="Address" class="control-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="MobileNo" class="control-label"></label>
                        <input asp-for="MobileNo" class="form-control" />
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="FaxNo" class="control-label"></label>
                        <input asp-for="FaxNo" class="form-control" />
                        <span asp-validation-for="FaxNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="PPFilePath" class="control-label"></label>
                        <input asp-for="PPFilePath" accept="image/png, image/jpeg, image/gif" class="form-control" />
                        <span asp-validation-for="PPFilePath" class="text-danger"></span>
                        @if (Model.Id != 0)
                        {
                            <img src="@Model.PPPhotoPath" alt="" height="50" width="50" id="profilePhoto" data-bs-toggle="modal" data-bs-target="#imagePreviewModal" />
                        }
                    </div>
                    <div class="col-md-4 position-relative">
                        <label asp-for="CitizenFilePath" class="control-label"></label>
                        <input asp-for="CitizenFilePath" accept="image/png, image/jpeg, image/gif" class="form-control" />
                        <span asp-validation-for="CitizenFilePath" class="text-danger"></span>
                        @if (Model.Id != 0)
                        {
                            <img src="@Model.CitizenPhotoPath" alt="" height="50" width="50" id="citizenPhoto" data-bs-toggle="modal" data-bs-target="#imagePreviewModal" />
                        }
                    </div>
                  
                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">Submit form</button>
                        <a asp-action="Member" class="btn btn-warning"><i class="fa fa-angle-left"></i> पछाडि फर्कनुहोस्</a>
                    </div>
                </form>
                <div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body">
                                <img id="imagePreview" src="" class="img-fluid" alt="Preview" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // $(document).ready(function () {
        $('#profilePhoto, #citizenPhoto').on('click', function () {
                var imgSrc = $(this).attr('src');  // Get the image source
                $('#imagePreview').attr('src', imgSrc);  // Set it to the modal image
            });
        // });
    </script>
<script>
        NepaliDatePickerCal(document.getElementById('CitizenIssueDate'));
    </script>
}