@model IEnumerable<UserViewModel>
@inject IUtility _utility

@{
    ViewData["Title"] = "User Management";
}
<style>
    .green-box {
        width: 15px;
        height: 15px;
        background-color: #008028;
    }

    .gray-box {
        width: 15px;
        height: 15px;
        background-color: #80a0ca;
    }

    .fa .fa-info-circle {
        font-size: 1.2rem !important;
    }

    .fa {
        font-size: 1.2rem !important;
    }
</style>
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pb-0 card-no-border">
                <div>
                    <h4>@ViewData["Title"]</h4>

                </div>
                <div>
                    @* <p class="mb-0"><a class="btn btn-primary pull-right btn-add" asp-area="Identity" asp-page="/Account/Register"><i class="fa fa-plus"></i> &nbsp; नयाँ बनाउनुहोस्</a></p> *@

                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive custom-scrollbar">
                    <table class="display" id="basic-1">
                        <thead>
                            <tr>
                                <th>S.N</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Role)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Active)
                                </th>

                                <th></th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var color = item.Active ? "green" : "red";
                                var isActive = item.Active ? "Active" : "InActive";
                                var isChecked = item.Active ? "checked" : "";
                                <tr style="color: @color">
                                    <td>
                                        @($"{Model.ToList().IndexOf(item) + 1}")
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Role)
                                    </td>
                                    <td>
                                        @isActive
                                    </td>
                                    <td>
                                        <a asp-action="UserDetails" asp-route-id="@item.Id"><i class="fa fa-info-circle"></i></a>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
