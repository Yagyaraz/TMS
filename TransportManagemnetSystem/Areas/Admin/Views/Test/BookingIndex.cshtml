@model List<TransportManagemnetSystem.Areas.Admin.Models.Seat> 
@{
    ViewData["Title"] = "Seat Booking";
}
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

<style>
    .bus-container {
        width: 400px;
        margin: auto;
        background-color: #f0f0f0;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .bus-title {
        text-align: center;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .seat-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .seat {
        width: 45px;
        height: 45px;
        background-color: #4CAF50;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }

    .seat.booked {
        background-color: #ff4d4d;
        cursor: not-allowed;
    }

    .seat input {
        display: none;
    }

    .bus-aisle {
        width: 20px;
    }

    .driver-seat {
        margin-bottom: 15px;
        display: flex;
        justify-content: center;
        font-size: 18px;
    }

    .submit-btn {
        width: 100%;
        margin-top: 15px;
    }
</style>

<div class="bus-container">
    <div class="bus-title">Bus Seat Booking</div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="post" asp-action="BookSeats">
        <div class="driver-seat">🚌 Driver</div>

        <div class="seat-row">
            @for (int i = 0; i < Model.Count; i += 5)
            {
                <!-- First Seat -->
                @if (i < Model.Count)
                {
                    <div class="seat @(Model[i].IsBooked ? "booked" : "")">
                        <input type="checkbox" id="seat-@Model[i].Id" name="selectedSeatIds" value="@Model[i].Id"
                        @(Model[i].IsBooked ? "disabled" : "") />
                        <label for="seat-@Model[i].Id">@Model[i].SeatNumber</label>
                    </div>
                }

                <!-- Second Seat -->
                @if (i + 1 < Model.Count)
                {
                    <div class="seat @(Model[i + 1].IsBooked ? "booked" : "")">
                        <input type="checkbox" id="seat-@Model[i + 1].Id" name="selectedSeatIds" value="@Model[i + 1].Id"
                        @(Model[i + 1].IsBooked ? "disabled" : "") />
                        <label for="seat-@Model[i + 1].Id">@Model[i + 1].SeatNumber</label>
                    </div>
                }

                <div class="bus-aisle"></div>

                <!-- Third Seat -->
                @if (i + 2 < Model.Count)
                {
                    <div class="seat @(Model[i + 2].IsBooked ? "booked" : "")">
                        <input type="checkbox" id="seat-@Model[i + 2].Id" name="selectedSeatIds" value="@Model[i + 2].Id"
                        @(Model[i + 2].IsBooked ? "disabled" : "") />
                        <label for="seat-@Model[i + 2].Id">@Model[i + 2].SeatNumber</label>
                    </div>
                }

                <!-- Fourth Seat -->
                @if (i + 3 < Model.Count)
                {
                    <div class="seat @(Model[i + 3].IsBooked ? "booked" : "")">
                        <input type="checkbox" id="seat-@Model[i + 3].Id" name="selectedSeatIds" value="@Model[i + 3].Id"
                        @(Model[i + 3].IsBooked ? "disabled" : "") />
                        <label for="seat-@Model[i + 3].Id">@Model[i + 3].SeatNumber</label>
                    </div>
                }

                <!-- Fifth Seat -->
                @if (i + 4 < Model.Count)
                {
                    <div class="seat @(Model[i + 4].IsBooked ? "booked" : "")">
                        <input type="checkbox" id="seat-@Model[i + 4].Id" name="selectedSeatIds" value="@Model[i + 4].Id"
                        @(Model[i + 4].IsBooked ? "disabled" : "") />
                        <label for="seat-@Model[i + 4].Id">@Model[i + 4].SeatNumber</label>
                    </div>
                }
            }
        </div>


        <input type="text" name="userName" class="form-control" placeholder="Enter your name" required />
        <button type="submit" class="btn btn-primary submit-btn">Book Selected Seats</button>
    </form>
</div>