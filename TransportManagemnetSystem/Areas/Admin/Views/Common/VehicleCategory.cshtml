@model IEnumerable<VehicleCategoryViewModel>
@{
    ViewData["Title"] = "Vehicle Category";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pb-0 card-no-border">
                <div>
                    <h4>@ViewData["Title"]</h4>

                </div>
                <div>
                    <p class="mb-0"><a class="btn btn-primary pull-right btn-add" asp-action="CreateVehicleCategory"><i class="fa fa-plus"></i> &nbsp; नयाँ बनाउनुहोस्</a></p>

                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive custom-scrollbar">
                    <table class="display" id="basic-1">
                        <thead>
                            <tr>
                                <th>S.N</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.NameNep)
                                </th>
                                <th></th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @($"{Model.ToList().IndexOf(item) + 1}")
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.NameNep)
                                    </td>
                                    <td>
                                        <a asp-action="CreateVehicleCategory" asp-route-id="@item.Id"><i class="fa fa-edit"></i></a>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
